      "node_modules/nanoid/**",
      "node_modules/node-api-headers/**",
      "node_modules/node-llama-cpp/**",
      "node_modules/parse-ms/**",
      "node_modules/path-key/**",
      "node_modules/pretty-bytes/**",
      "node_modules/pretty-ms/**",
      "node_modules/proper-lockfile/**",
      "node_modules/rc/**",
      "node_modules/require-directory/**",
      "node_modules/retry/**",
      "node_modules/semver/**",
      "node_modules/shebang-command/**",
      "node_modules/shebang-regex/**",
      "node_modules/signal-exit/**",
      "node_modules/simple-git/**",
      "node_modules/sleep-promise/**",
      "node_modules/stdin-discarder/**",
      "node_modules/stdout-update/**",
      "node_modules/steno/**",
      "node_modules/string-width/**",
      "node_modules/strip-ansi/**",
      "node_modules/strip-json-comments/**",
      "node_modules/universalify/**",
      "node_modules/url-join/**",
      "node_modules/validate-npm-package-name/**",
      "node_modules/which/**",
      "node_modules/wrap-ansi/**",
      "node_modules/y18n/**",
      "node_modules/yargs/**",
      "node_modules/yargs-parser/**",
      "node_modules/yoctocolors/**",
      "node_modules/@node-llama-cpp/win-x64/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "tvmaty2186",
        "repo": "pdf-pro-versiones",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "build/node-win/node.exe",
        "to": "node/node.exe"
      },
      {
        "from": "build/ocr-modelos",
        "to": "ocr",
        "filter": [
          "det.onnx",
          "rec.onnx",
          "dict.txt"
        ]
      }
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tesseract.js-data/spa": "^1.0.0",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "heic-decode": "^2.1.0",
    "mupdf": "^1.28.1",
    "node-llama-cpp": "^3.22.2",
    "onnxruntime-node": "^1.30.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "^25.1.8"
  }
}
