      "!node_modules/@node-llama-cpp/mac-*/**",
      "!node_modules/@node-llama-cpp/win-arm64/**",
      "!node_modules/@node-llama-cpp/win-x64-*/**"
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "Documento PDF",
        "role": "Editor",
        "icon": "build/icon.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "PDF.Pro",
      "language": "3082",
      "include": "build/instalador.nsh"
    },
    "asarUnpack": [
      "node_modules/mupdf/**",
      "**/tesseract.js/**",
      "**/tesseract.js-core/**",
      "**/@tesseract.js-data/**",
      "**/bmp-js/**",
      "**/idb-keyval/**",
      "**/is-url/**",
      "**/node-fetch/**",
      "**/whatwg-url/**",
      "**/tr46/**",
      "**/webidl-conversions/**",
      "**/regenerator-runtime/**",
      "**/wasm-feature-detect/**",
      "**/zlibjs/**",
      "node_modules/onnxruntime-node/**",
      "ia-local.js",
      "node_modules/@huggingface/jinja/**",
      "node_modules/@isaacs/fs-minipass/**",
      "node_modules/@kwsites/file-exists/**",
      "node_modules/@kwsites/promise-deferred/**",
