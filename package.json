{
  "name": "pdf-pro",
  "productName": "PDF.Pro",
  "version": "0.39.2",
  "description": "Editor de PDF con asistente",
  "author": "Matías Russo",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node pruebas/correr.js",
    "dist": "node build/clave-errores.js && node build/ia-local-win.js && node build/ocr-win.js && electron-builder --win nsis --x64",
    "publicar": "node build/clave-errores.js && node build/ia-local-win.js && node build/ocr-win.js && electron-builder --win nsis --x64 --publish always"
  },
  "build": {
    "appId": "com.pdfpro.app",
    "files": [
      "main.js",
      "preload.js",
      "convertir.js",
      "asistente.js",
      "gemini.js",
      "ocr-paddle.js",
      "ia-local-cliente.js",
      "errores.js",
      "motor.js",
      "motor-cliente.js",
      "motor-trabajos.js",
      "clave-errores.json",
      "src/**",
      "build/icon.png",
      "node_modules/pdfjs-dist/build/pdf.min.mjs",
      "node_modules/pdf-lib/dist/pdf-lib.esm.min.js",
      "node_modules/pdfjs-dist/build/pdf.worker.min.mjs",
      "node_modules/pdfjs-dist/cmaps/**",
      "node_modules/pdfjs-dist/standard_fonts/**",
      "node_modules/heic-decode/**",
      "node_modules/libheif-js/package.json",
      "node_modules/libheif-js/wasm-bundle.js",
      "node_modules/libheif-js/libheif-wasm/libheif-bundle.js",
      "node_modules/mupdf/package.json",
      "node_modules/mupdf/dist/mupdf.js",
      "node_modules/mupdf/dist/mupdf-wasm.js",
      "node_modules/mupdf/dist/mupdf-wasm.wasm",
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/package.json",
      "node_modules/tesseract.js-core/**",
      "!node_modules/tesseract.js-core/*.wasm.js",
      "node_modules/bmp-js/**",
      "node_modules/idb-keyval/**",
      "node_modules/is-url/**",
      "node_modules/node-fetch/**",
      "node_modules/whatwg-url/**",
      "node_modules/tr46/**",
      "node_modules/webidl-conversions/**",
      "node_modules/regenerator-runtime/**",
