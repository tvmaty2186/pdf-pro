      "node_modules/argparse/**",
      "node_modules/lazy-val/**",
      "node_modules/lodash.escaperegexp/**",
      "node_modules/lodash.isequal/**",
      "node_modules/tiny-typed-emitter/**",
      "node_modules/builder-util-runtime/**",
      "node_modules/sax/**",
      "fuentes.js",
      "node_modules/@pdf-lib/fontkit/dist/fontkit.umd.min.js",
      "node_modules/@pdf-lib/fontkit/dist/fontkit.umd.js",
      "node_modules/@pdf-lib/fontkit/package.json",
      "node_modules/pako/**",
      "package.json",
      "node_modules/onnxruntime-node/package.json",
      "node_modules/onnxruntime-node/dist/**",
      "node_modules/onnxruntime-node/bin/napi-v6/win32/x64/**",
      "node_modules/onnxruntime-common/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**",
